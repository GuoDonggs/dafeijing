# —— Python 运行时垃圾 ——
__pycache__/
*.py[cod]
.venv/
venv/

# —— 打包产物（PyInstaller）——
# dist/ 是 scripts/build_exe.py 的成品目录（几百 MB），build/pyinstaller/ 是它的中间产物。
# 注意：build/ 本身还是程序运行期的工作目录（记忆、自检音频、生成的关键词表），
# 所以这里只忽略 PyInstaller 的那一层，不整个忽略 build/。
dist/
dist-slim/
build/pyinstaller/
# 打包前会把「放在 exe 旁边的用户数据」暂存到这里，打完再放回去。
# config.yaml 就在其中（含 API Key），绝对不能入库。
build/dist-user-data/

# —— 运行期落盘的数据 ——
build/memory.json
build/selftest.wav
build/keywords.generated.txt
build/vision/
build/screenshots/
# 声纹档：里面是声纹向量，属于生物特征，不入库
build/voiceprint.json
build/voiceprint.json.bak
# 找图 / 屏幕匹配测试留下的临时图
build/tpl*.png
build/tpl*.jpg

# 跨轮上下文：里面有你说过的话，不入库
build/conversation.json
# 权限审计日志：记的是每次敏感操作的参数，属于本机隐私，不入库
build/audit.jsonl
build/audit.1.jsonl

# 某些库会把中间产物写到 ./media（2048×2048 的 PNG 之类），是运行时产物，不入库
media/
# 临时文件：提交信息（git commit -F 用）与排查用的小脚本
build/commit-msg*.txt
build/cmsg*.txt
build/*probe*.py
build/_*.py
# 探测/调试留下的音频
build/_*.wav
build/_*.mp3

# 本地应用映射表：每台机器的路径都不一样，不入库（工具会自动按需创建）
apps.yaml

# —— 模型权重：约 1.2 GB，不入库 ——
# 打包时刻意不把模型放进 exe，运行时从 ../voice-assistant/models 或 ./models 读。
models/

# —— 本地配置：里面有 API Key，别提交 ——
config.yaml
config.yaml.bak

# —— Node 残留 ——
# 本项目没有 Node 构建步骤（web/ 是免依赖的原生 JS），node_modules/ 是空壳。
# 这几个是早期误留的，真要纳入版本管理就 git add -f。
node_modules/
package.json
package-lock.json
